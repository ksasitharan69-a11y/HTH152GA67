# ==============================================================================
# HireProof AI - Backend Environment Configuration
# Problem: HTH-GA-04 — Explainable Candidate–Role Fit Engine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (SQLAlchemy ORM)
# ------------------------------------------------------------------------------
# Default Local SQLite Database:
DATABASE_URL=sqlite:///./hireproof.db

# Supabase PostgreSQL Connection String (Pooler or Direct):
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or: postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Supabase Storage & Services (Backend-Only, Never Expose to Frontend)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
# Options: 'local' (default disk fallback) or 'supabase'
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=resumes

# ------------------------------------------------------------------------------
# 3. Security, Session & JWT Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=hireproof_ai_super_secret_jwt_key_hackathon_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=15

# ------------------------------------------------------------------------------
# 4. AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Supported Providers: gemini, openai, groq, ollama, or custom OpenAI-compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
# Optional generic key:
LLM_API_KEY=
# Dedicated Gemini API Key (used for Candidate Assessment & Skill Verification):
GEMINI_API_KEY=
# Dedicated OpenAI API Key:
OPENAI_API_KEY=
# Optional custom LLM endpoint:
# LLM_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. Local File Uploads & Fallback Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. CORS & Frontend Client
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
