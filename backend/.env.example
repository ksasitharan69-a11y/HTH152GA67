# HireProof AI Environment Configuration

# Database
# For SQLite (default for development/portable testing):
DATABASE_URL=sqlite:///./hireproof.db
# For MySQL / MariaDB:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hireproof_ai

# Security & JWT
SECRET_KEY=hireproof_ai_super_secret_jwt_key_hackathon_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=15

# LLM Configuration
# Providers supported: gemini, openai, groq, ollama, or standard openapi-compatible
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://api.openai.com/v1

# CORS & Frontend
FRONTEND_URL=http://localhost:5173

# Document Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
